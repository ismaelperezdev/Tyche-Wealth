<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-assets-sequence" author="tyche-wealth">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <sequenceExists sequenceName="assets_seq"/>
            </not>
        </preConditions>

        <createSequence sequenceName="assets_seq" startValue="1" incrementBy="1"/>

        <rollback>
            <dropSequence sequenceName="assets_seq"/>
        </rollback>

    </changeSet>

    <changeSet id="create-assets-table" author="tyche-wealth">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="assets"/>
            </not>
        </preConditions>

        <createTable tableName="assets">
            <column name="id" type="BIGINT" defaultValueSequenceNext="assets_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="portfolio_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="symbol" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="asset_type" type="VARCHAR(30)">
                <constraints
                        nullable="false"
                        checkConstraint="asset_type IN ('STOCK', 'ETF', 'CRYPTO', 'BOND', 'COMMODITY', 'FOREX')"/>
            </column>
            <column name="quantity" type="DECIMAL(19,8)">
                <constraints nullable="false" checkConstraint="quantity >= 0"/>
            </column>
            <column name="average_price" type="DECIMAL(19,4)">
                <constraints nullable="false" checkConstraint="average_price >= 0"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints
                        nullable="false"
                        checkConstraint="currency IN ('EUR', 'USD', 'GBP', 'CHF', 'JPY', 'CNY', 'ARS', 'BRL', 'CLP', 'COP',
                        'DOP', 'MXN', 'PEN', 'PYG', 'SVC', 'UYU', 'VES')"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="assets"
                baseColumnNames="portfolio_id"
                constraintName="fk_assets_portfolios"
                referencedTableName="portfolios"
                referencedColumnNames="id"/>

        <rollback>
            <dropTable tableName="assets"/>
        </rollback>

    </changeSet>

    <changeSet id="create-assets-portfolio-id-index" author="tyche-wealth">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <indexExists indexName="idx_assets_portfolio_id" tableName="assets"/>
            </not>
        </preConditions>

        <createIndex indexName="idx_assets_portfolio_id" tableName="assets">
            <column name="portfolio_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_assets_portfolio_id" tableName="assets"/>
        </rollback>

    </changeSet>

    <changeSet id="add-assets-name-column" author="tyche-wealth">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="assets" columnName="name"/>
            </not>
        </preConditions>

        <addColumn tableName="assets">
            <column name="name" type="VARCHAR(60)" defaultValue="Unknown Asset">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="assets" columnName="name"/>
        </rollback>

    </changeSet>

    <changeSet id="drop-assets-name-default-value" author="tyche-wealth">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <columnExists tableName="assets" columnName="name"/>
        </preConditions>

        <dropDefaultValue tableName="assets" columnName="name" columnDataType="VARCHAR(60)"/>

        <rollback>
            <addDefaultValue tableName="assets" columnName="name" columnDataType="VARCHAR(60)" defaultValue="Unknown Asset"/>
        </rollback>

    </changeSet>

    <changeSet id="cleanup-duplicate-assets-portfolio-symbol" author="tyche-wealth">

        <preConditions onFail="HALT" onError="HALT"
                       onFailMessage="Inconsistent duplicate assets detected for (portfolio_id, symbol). Resolve conflicting rows before applying uq_asset_portfolio_id_symbol.">
            <tableExists tableName="assets"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM (
                    SELECT portfolio_id, symbol
                    FROM assets
                    GROUP BY portfolio_id, symbol
                    HAVING COUNT(*) &gt; 1
                       AND (
                           MIN(quantity) &lt;&gt; MAX(quantity)
                        OR MIN(average_price) &lt;&gt; MAX(average_price)
                        OR MIN(name) &lt;&gt; MAX(name)
                        OR MIN(created_at) &lt;&gt; MAX(created_at)
                        OR MIN(COALESCE(CAST(updated_at AS VARCHAR(64)), '')) &lt;&gt; MAX(COALESCE(CAST(updated_at AS VARCHAR(64)), ''))
                       )
                ) inconsistent_duplicates
            </sqlCheck>
        </preConditions>

        <sql>
            DELETE FROM assets
            WHERE id IN (
                SELECT id
                FROM (
                    SELECT id,
                           ROW_NUMBER() OVER (PARTITION BY portfolio_id, symbol ORDER BY id) AS rn
                    FROM assets
                ) duplicates
                WHERE duplicates.rn &gt; 1
            );
        </sql>

    </changeSet>

    <changeSet id="add-assets-portfolio-symbol-unique-constraint" author="tyche-wealth">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <uniqueConstraintExists tableName="assets" constraintName="uq_asset_portfolio_id_symbol"/>
            </not>
        </preConditions>

        <addUniqueConstraint
                tableName="assets"
                columnNames="portfolio_id,symbol"
                constraintName="uq_asset_portfolio_id_symbol"/>

        <rollback>
            <dropUniqueConstraint tableName="assets" constraintName="uq_asset_portfolio_id_symbol"/>
        </rollback>

    </changeSet>

    <changeSet id="alter-assets-name-length-to-200" author="tyche-wealth">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <columnExists tableName="assets" columnName="name"/>
        </preConditions>

        <modifyDataType tableName="assets" columnName="name" newDataType="VARCHAR(200)"/>

        <rollback>
            <modifyDataType tableName="assets" columnName="name" newDataType="VARCHAR(60)"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
